# --- Postgres ---
POSTGRES_USER=portside
POSTGRES_PASSWORD=changeme
POSTGRES_DB=portside
DATABASE_URL=postgresql://portside:changeme@postgres:5432/portside

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Encryption (32 random bytes, base64) ---
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PORTSIDE_ENCRYPTION_KEY=

# --- Session ---
SESSION_SECRET=changeme-generate-a-long-random-string

# --- GitHub OAuth ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://api.localhost/auth/github/callback

# --- Domain config (local dev default) ---
PORTSIDE_BASE_DOMAIN=localhost
PORTSIDE_APP_PROTOCOL=http

# --- Docker ---
DOCKER_SOCKET_PROXY_HOST=tcp://docker-socket-proxy:2375

# --- Shared workspace volume (build contexts, zip uploads) ---
PORTSIDE_WORKSPACES_ROOT=/var/portside/workspaces

# --- Ports (host-side, dev only) ---
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080
